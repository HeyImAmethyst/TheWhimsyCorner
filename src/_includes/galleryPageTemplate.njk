<!DOCTYPE html>
<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{ pageDescription }}" />
    {% include 'elements/htmlHeadGallery.njk' %} <!-- adds content of _includes/headGallery.njk here -->
  </head>
  
  <body>

    <div id= "main-container">

      {% include 'elements/header.njk' %} <!-- adds content of _includes/header.njk here -->

      {% include 'elements/navBar.njk' %} <!-- adds content of _includes/navBar.njk here -->

      <main id="center-container">

        <center>
            <h1>{{ pageTitle }}</h1>
            <div class="gallery" data-tag="{{ pageTitle }}">
                <!--galleryLoader shows while gallery items are parsed from the media json-->
                <div class="galleryLoader">
                    <div>
                        <img class="freeze" src="{{ nesting }}img/hourglass.gif" alt="Loading..." />
                        <p>Loading...</p>
                    </div>
                </div>
            </div>
            <a href="/NeoGallery.html"> BACK TO GALLERY</a>
            <!--myModal shows when an image is clicked-->
            <div id="myModal" class="modal">
                <span class="close">&times;</span>
                <img id="loadingPlaceholder" class="loading" src="{{ nesting }}img/hourglass.gif" />
                <img class="modal-content" id="img01" />
                <div id="title"></div>
                <div id="caption"></div>
            </div>
        </center>

      </main>

      {% include 'elements/rightSideBar.njk' %} <!-- adds content of _includes/rightSideBar.njk here -->

      {% include 'elements/footer.njk' %} <!-- adds content of _includes/footer.njk here -->

    </div>

  </body>
</html>