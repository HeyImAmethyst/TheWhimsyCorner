<main id="center-container">
    <center>
        <a id="reshuffle"
            >Random Selection, by default loads 6 random entries. id="reshuffle" will make an element
            reshuffle it. Click me.
        </a>
    </center>

    <!--if you want to add a new gallery item on your page, add everything between this comment, and the one that states 'snippet end'-->
    <div class="gallery" data-tag="random">
        <!--galleryLoader shows while gallery items are parsed from the media json-->
        <div class="galleryLoader">
            <div>
                <img src="{{ nesting }}img/hourglass.gif" alt="Loading..." />
                <p>Loading...</p>
            </div>
        </div>
    </div>

    <!--myModal shows when an image is clicked-->
    <div id="myModal" class="modal">
        <span class="close">&times;</span>
        <img id="loadingPlaceholder" class="loading" src="{{ nesting }}img/hourglass.gif" />
        <img class="modal-content" id="img01" />
        <div id="title"></div>
        <div id="caption"></div>
    </div>

    <!--snippet end-->
    <center>
